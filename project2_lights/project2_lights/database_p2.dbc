VAL_TABLE_ power_window_down_Value_Table 3 "not available" 2 "error" 1 "power_window_down_on" 0 "power_window_down_off" ;
VAL_TABLE_ power_window_up_Value_Table 3 "not available" 2 "error" 1 "power_window_up_on" 0 "power_window_up_off" ;
VAL_TABLE_ wiper_washer_Value_Table 5 "not applicable" 4 "error" 3 "wiper_washer_high" 2 "wiper_washer_low" 1 "wiper_washer_INT" 0 "wiper_washer_OFF" ;
VAL_TABLE_ ignition_Signal 5 "gnition_not available" 4 "gnition_error" 3 "gnition_start" 2 "gnition_ON" 1 "gnition_Accessary" 0 "gnition_Lock" ;
