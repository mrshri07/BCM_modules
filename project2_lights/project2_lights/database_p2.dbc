VAL_TABLE_ DRL_swt_Signal 3 "DRL_swt_not available" 2 "DRL_swt_error" 1 "DRL_swt_OFF" 0 "DRL_swt_ON" ;
VAL_TABLE_ direction_swt_signal 4 "direction_swt_not available" 3 "direction_swt_error" 2 "direction_swt_ON" 1 "direction_swt_right" 0 "direction_swt_left" ;


